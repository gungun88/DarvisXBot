generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  GROUP
  SUPERGROUP
  CHANNEL
  PRIVATE
}

enum ChatStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuleType {
  KEYWORD
  LINK
  AUTO_REPLY
  SPAM
}

enum RuleAction {
  DELETE_MESSAGE
  MUTE_USER
  BAN_USER
  REPLY
}

enum ScheduledMessageStatus {
  DRAFT
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum GiveawayStatus {
  DRAFT
  ACTIVE
  DRAWN
  CANCELLED
  FAILED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BotSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentOrderStatus {
  PENDING
  WAITING
  CONFIRMED
  FINISHED
  FAILED
  EXPIRED
  REFUNDED
}

enum ChatStatsEventType {
  JOIN
  LEAVE
  INVITE
}

enum PointTransactionType {
  SIGN_IN
  SPEECH
  INVITE
  MANUAL
  LOTTERY
  EXCHANGE
}

enum PointProductCodeStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  VOID
}

enum PointRedemptionStatus {
  DELIVERY_PENDING
  FULFILLED
  REFUNDED
  CANCELLED
}

model User {
  id             String    @id @default(cuid())
  telegramUserId BigInt    @unique @map("telegram_user_id")
  username       String?   @db.VarChar(64)
  firstName      String?   @map("first_name") @db.VarChar(128)
  lastName       String?   @map("last_name") @db.VarChar(128)
  languageCode   String?   @map("language_code") @db.VarChar(16)
  timezone       String    @default("Asia/Shanghai") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  ownedChats        Chat[]             @relation("ChatOwner")
  adminAssignments  ChatAdmin[]
  createdGiveaways  Giveaway[]         @relation("GiveawayCreator")
  giveawayEntries   GiveawayEntry[]
  memberships       Membership[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  createdInviteLinks InviteLink[]      @relation("InviteLinkCreator")
  inviteJoins        InviteJoin[]
  pointBalances      ChatPointBalance[]
  pointTransactions  ChatPointTransaction[] @relation("PointTransactionUser")
  actedPointTransactions ChatPointTransaction[] @relation("PointTransactionActor")
  pointRedemptions   PointRedemption[]
  botSubscription    BotSubscription?
  paymentOrders      PaymentOrder[]

  @@map("users")
}

model Chat {
  id             String     @id @default(cuid())
  telegramChatId BigInt     @unique @map("telegram_chat_id")
  type           ChatType
  title          String?    @db.VarChar(255)
  username       String?    @db.VarChar(64)
  ownerUserId    String?    @map("owner_user_id")
  timezone       String     @default("Asia/Shanghai") @db.VarChar(64)
  status         ChatStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  owner             User?              @relation("ChatOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  admins            ChatAdmin[]
  settings          Setting[]
  moderationRules   ModerationRule[]
  scheduledMessages ScheduledMessage[]
  giveaways         Giveaway[]
  memberships       Membership[]
  auditLogs         AuditLog[]
  dailyMessageStats ChatDailyMessageStat[]
  statsEvents       ChatStatsEvent[]
  inviteLinks       InviteLink[]
  inviteJoins       InviteJoin[]
  joinVerifications JoinVerification[]
  pointBalances     ChatPointBalance[]
  pointTransactions ChatPointTransaction[]
  pointProducts     PointProduct[]
  pointRedemptions  PointRedemption[]
  moderationEvents ModerationEvent[]

  @@map("chats")
}

model ChatAdmin {
  id          String   @id @default(cuid())
  chatId      String   @map("chat_id")
  userId      String   @map("user_id")
  role        String   @db.VarChar(64)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_admins")
}

model Setting {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, key])
  @@map("settings")
}

model AppSetting {
  key       String   @id @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model ModerationRule {
  id        String     @id @default(cuid())
  chatId    String     @map("chat_id")
  ruleType  RuleType   @map("rule_type")
  pattern   String
  action    RuleAction
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, ruleType, enabled])
  @@map("moderation_rules")
}

model ModerationEvent {
  id             String   @id @default(cuid())
  chatId         String   @map("chat_id")
  telegramUserId BigInt?  @map("telegram_user_id")
  eventType      String   @map("event_type") @db.VarChar(64)
  action         String   @db.VarChar(64)
  reason         String?  @db.VarChar(255)
  matchedPattern String?  @map("matched_pattern") @db.VarChar(255)
  messageId      Int?     @map("message_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([eventType, action, createdAt])
  @@index([telegramUserId, createdAt])
  @@map("moderation_events")
}

model ScheduledMessage {
  id            String                 @id @default(cuid())
  chatId        String                 @map("chat_id")
  contentType   String                 @map("content_type") @db.VarChar(32)
  content       Json
  buttons       Json?
  sendAt        DateTime               @map("send_at")
  repeatRule    Json?                  @map("repeat_rule")
  status        ScheduledMessageStatus @default(PENDING)
  lastError     String?                @map("last_error")
  attemptCount  Int                    @default(0) @map("attempt_count")
  lastAttemptAt DateTime?              @map("last_attempt_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@map("scheduled_messages")
}

model Giveaway {
  id               String         @id @default(cuid())
  chatId           String         @map("chat_id")
  title            String         @db.VarChar(255)
  description      String?
  prize            String         @db.VarChar(255)
  winnersCount     Int            @map("winners_count")
  joinRequirements Json?          @map("join_requirements")
  drawResult       Json?          @map("draw_result")
  drawAt           DateTime       @map("draw_at")
  status           GiveawayStatus @default(DRAFT)
  lastError        String?        @map("last_error")
  attemptCount     Int            @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?      @map("last_attempt_at")
  createdBy        String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  chat    Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User             @relation("GiveawayCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  entries GiveawayEntry[]

  @@index([chatId, status, drawAt])
  @@map("giveaways")
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String   @map("giveaway_id")
  userId     String   @map("user_id")
  joinedAt   DateTime @default(now()) @map("joined_at")
  isValid    Boolean  @default(true) @map("is_valid")

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@map("giveaway_entries")
}

model Membership {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  chatId    String           @map("chat_id")
  startsAt  DateTime         @map("starts_at")
  expiresAt DateTime         @map("expires_at")
  status    MembershipStatus @default(ACTIVE)
  source    String           @default("manual") @db.VarChar(64)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, status, expiresAt])
  @@map("memberships")
}

model BotSubscription {
  id        String                 @id @default(cuid())
  userId    String                 @unique @map("user_id")
  expiresAt DateTime               @map("expires_at")
  status    BotSubscriptionStatus  @default(ACTIVE)
  source    String                 @default("manual") @db.VarChar(64)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("bot_subscriptions")
}

model PaymentOrder {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  provider          String            @default("nowpayments") @db.VarChar(32)
  planKey           String            @map("plan_key") @db.VarChar(16)
  months            Int
  amountUsd         Decimal           @map("amount_usd") @db.Decimal(18, 8)
  payCurrency       String?           @map("pay_currency") @db.VarChar(32)
  providerPaymentId String?           @unique @map("provider_payment_id") @db.VarChar(128)
  payUrl            String?           @map("pay_url") @db.VarChar(1024)
  status            PaymentOrderStatus @default(PENDING)
  rawPayload        Json?             @map("raw_payload")
  paidAt            DateTime?         @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@map("payment_orders")
}

model AuditLog {
  id          String   @id @default(cuid())
  chatId      String?  @map("chat_id")
  actorUserId String?  @map("actor_user_id")
  action      String   @db.VarChar(128)
  targetType  String?  @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(128)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  chat  Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@map("audit_logs")
}

model AdminSession {
  id        String    @id @default(cuid())
  jti       String    @unique @db.VarChar(64)
  username  String    @db.VarChar(128)
  role      String    @default("owner") @db.VarChar(32)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([username, revokedAt, expiresAt])
  @@map("admin_sessions")
}

model AdminAccount {
  id               String    @id @default(cuid())
  username         String    @unique @db.VarChar(128)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             String    @default("operator") @db.VarChar(32)
  enabled          Boolean   @default(true)
  bootstrapManaged Boolean   @default(false) @map("bootstrap_managed")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([enabled, role])
  @@map("admin_accounts")
}

model ChatDailyMessageStat {
  id           String   @id @default(cuid())
  chatId       String   @map("chat_id")
  userId       String   @map("user_id")
  statDate     String   @map("stat_date") @db.VarChar(10)
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId, statDate])
  @@index([chatId, statDate])
  @@map("chat_daily_message_stats")
}

model ChatStatsEvent {
  id           String             @id @default(cuid())
  chatId       String             @map("chat_id")
  eventType    ChatStatsEventType @map("event_type")
  actorUserId  String?            @map("actor_user_id")
  targetUserId String?            @map("target_user_id")
  statDate     String             @map("stat_date") @db.VarChar(10)
  createdAt    DateTime           @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, eventType, statDate])
  @@index([chatId, actorUserId, statDate])
  @@map("chat_stats_events")
}

model InviteLink {
  id                 String    @id @default(cuid())
  chatId             String    @map("chat_id")
  creatorUserId      String    @map("creator_user_id")
  inviteLink         String    @unique @map("invite_link") @db.VarChar(512)
  expireAt           DateTime? @map("expire_at")
  memberLimit        Int?      @map("member_limit")
  createsJoinRequest Boolean   @default(false) @map("creates_join_request")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  chat    Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User         @relation("InviteLinkCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  joins   InviteJoin[]

  @@index([chatId, creatorUserId, revokedAt])
  @@map("invite_links")
}

model InviteJoin {
  id           String    @id @default(cuid())
  chatId       String    @map("chat_id")
  userId       String    @map("user_id")
  inviteLinkId String?   @map("invite_link_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")

  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteLink InviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: SetNull)

  @@unique([chatId, userId])
  @@index([chatId, inviteLinkId])
  @@map("invite_joins")
}

model JoinVerification {
  id             String   @id
  chatId         String   @map("chat_id")
  telegramChatId BigInt   @map("telegram_chat_id")
  telegramUserId BigInt   @map("telegram_user_id")
  messageId      Int      @map("message_id")
  mode           String   @db.VarChar(32)
  answer         String   @db.VarChar(64)
  punishment     String   @db.VarChar(16)
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, telegramUserId])
  @@index([expiresAt])
  @@map("join_verifications")
}

model ChatPointBalance {
  id               String   @id @default(cuid())
  chatId           String   @map("chat_id")
  userId           String   @map("user_id")
  balance          Int      @default(0)
  lastTransactionAt DateTime? @map("last_transaction_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId, balance])
  @@map("chat_point_balances")
}

model ChatPointTransaction {
  id           String               @id @default(cuid())
  chatId       String               @map("chat_id")
  userId       String               @map("user_id")
  actorUserId   String?              @map("actor_user_id")
  type         PointTransactionType
  delta        Int
  balanceAfter Int?                 @map("balance_after")
  referenceKey String?              @unique @map("reference_key") @db.VarChar(128)
  dayKey       String?              @map("day_key") @db.VarChar(10)
  note         String?              @db.VarChar(255)
  metadata     Json                 @default("{}")
  createdAt    DateTime             @default(now()) @map("created_at")

  chat  Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user  User @relation("PointTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("PointTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  redemption PointRedemption?

  @@index([chatId, userId, createdAt])
  @@index([chatId, userId, type, dayKey])
  @@index([chatId, type, createdAt])
  @@map("chat_point_transactions")
}

model PointProduct {
  id          String    @id @default(cuid())
  chatId      String    @map("chat_id")
  externalId  String    @map("external_id") @db.VarChar(16)
  name        String    @db.VarChar(64)
  cost        Int
  listed      Boolean   @default(false)
  dailyLimit  Int       @default(0) @map("daily_limit")
  soldCount   Int       @default(0) @map("sold_count")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  chat        Chat               @relation(fields: [chatId], references: [id], onDelete: Cascade)
  codes       PointProductCode[]
  redemptions PointRedemption[]

  @@unique([chatId, externalId])
  @@index([chatId, listed, archivedAt])
  @@map("point_products")
}

model PointProductCode {
  id          String                 @id @default(cuid())
  productId   String                 @map("product_id")
  value       String                 @db.VarChar(255)
  status      PointProductCodeStatus @default(AVAILABLE)
  reservedAt  DateTime?              @map("reserved_at")
  deliveredAt DateTime?              @map("delivered_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  product    PointProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  redemption PointRedemption?

  @@unique([productId, value])
  @@index([productId, status, createdAt])
  @@map("point_product_codes")
}

model PointRedemption {
  id            String                @id @default(cuid())
  chatId        String                @map("chat_id")
  productId     String                @map("product_id")
  codeId        String                @unique @map("code_id")
  userId        String                @map("user_id")
  transactionId String                @unique @map("transaction_id")
  cost          Int
  dayKey        String                @map("day_key") @db.VarChar(10)
  status        PointRedemptionStatus @default(DELIVERY_PENDING)
  deliveryError String?               @map("delivery_error")
  deliveredAt   DateTime?             @map("delivered_at")
  refundedAt    DateTime?             @map("refunded_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  chat        Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  product     PointProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  code        PointProductCode     @relation(fields: [codeId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction ChatPointTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([chatId, status, createdAt])
  @@index([chatId, userId, dayKey])
  @@index([productId, createdAt])
  @@map("point_redemptions")
}
