NODE_ENV=development
BOT_MODE=polling
HOST=0.0.0.0
PORT=3000

# Telegram BotFather token
BOT_TOKEN=replace-with-your-bot-token
BOT_USERNAME=DarvisXBot
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-at-least-16-chars
DROP_PENDING_UPDATES=true

DATABASE_URL=postgresql://darvisxbot:darvisxbot@localhost:15433/darvisxbot?schema=public
REDIS_URL=redis://localhost:6379
DEFAULT_TIMEZONE=Asia/Shanghai

# Admin console credentials. Always replace these values in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN_TTL=8h
# Optional RFC 6238 TOTP secret (base32, at least 16 characters).
ADMIN_TOTP_SECRET=

# Optional production membership payments. Leave unset to keep plan buttons informational.
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PUBLIC_BASE_URL=https://your-domain.example

# Optional operations monitoring. Install pg_dump on the host before running backups.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
# Require a successful full restore drill at least once per week.
RESTORE_MAX_AGE_HOURS=168
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
